  "wardrobe_assets": {
    "skin": {
      "nid": 1136,
      "title": "Light Skin Male Bronze",
      "username": "MargaretToigo",
      "license": "CC0",
      "compatibility": "1.1.x",
      "changed": "2019-02-12",
      "description": "This is a bronze variation on the young light skinned male."
    },
    "shirt": {
      "nid": 1203,
      "title": "T-shirt Basic Tucked",
      "username": "MargaretToigo",
      "license": "CC0",
      "compatibility": "1.1.x",
      "changed": "2017-12-07",
      "description": "This is a basic T-shirt with the bottom hemline scaled so that the shirt looks tucked into pants. It was made for adult male humans, but will fit other average humans. A subsurf of at least two is recommended. I designed it to be worn with my Wool Pants --\n seen in example pic -- (http://www.makehumancommunity.org/clothes/wool_pants.html), but with a little adjustment, it can also be paired with other bottoms. The bump texture is needed for realism. Several other colors are in Materials. Illustration was rendered with subsurf set to two. Model, Jerome, is also wearing Mindfront's Shoes Monk Strap male, http://www.makehumancommunity.org/clothes/shoes_monk_strap_male.html"
    },
    "trousers": {
      "nid": 1194,
      "title": "Wool Pants",
      "username": "MargaretToigo",
      "license": "CC0",
      "compatibility": "1.1.x",
      "changed": "2017-12-07",
      "description": "This is a pair of wool pants designed for male humans, but will fit other average humans, too. Several other colors are in Materials. \n\nIllustration also pictures Shoes Monk Strap male, by Mindfront. http://www.makehumancommunity.org/clothes/shoes_monk_strap_male.html"
    },
    "footwear": {
      "nid": 1732,
      "title": "Men's Loafers",
      "username": "MargaretToigo",
      "license": "CC0",
      "compatibility": "1.1.x",
      "changed": "2018-11-12",
      "description": "This is a pair of men's loafers with socks. They will fit most male humans ages 10-60. I have included diffuse, specular and normal maps and the .mhmat file should get them all imported into Blender, where their properties can be adjusted according to preference and render engine. Illustration shows shoes with subsurf of two. "
    },
    "bob": {
      "nid": 1669,
      "title": "Blunt Bob",
      "username": "MargaretToigo",
      "license": "CC0",
      "compatibility": "1.1.x",
      "changed": "2018-10-16",
      "description": "This is a blunt bob hairstyle that will go on most humans. Some slight adjustments may be needed for toddler, senior and plus-size humans.  I have included diffuse, specular and normal maps and the .mhmat file should get them all imported into Blender, where their properties can be adjusted according to preference and render engine. Illustration shows hair with Subsurf of two. Three additional colors are available in Materials. "
    }
  }
